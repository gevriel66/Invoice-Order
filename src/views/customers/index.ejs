<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/navbar') %>

    <div class="container-fluid p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">Master Customer</h3>
                <p class="text-muted small mb-0">Kelola data identitas pelanggan, perusahaan, alamat penerima, dan kontak.</p>
            </div>
            <button type="button" class="btn btn-primary btn-primary-custom text-nowrap" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
                <i class="bi bi-plus-lg me-1"></i> Tambah Customer
            </button>
        </div>

        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="card card-custom mb-4">
            <div class="card-body p-3">
                <form action="/customers" method="GET" class="row g-2">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" name="search" placeholder="Cari nama customer, perusahaan, atau HP..." value="<%= search %>">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                    </div>
                    <% if (search) { %>
                        <div class="col-md-2">
                            <a href="/customers" class="btn btn-outline-secondary w-100">Reset</a>
                        </div>
                    <% } %>
                </form>
            </div>
        </div>

        <div class="card card-custom">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Nama Pelanggan</th>
                                <th>Perusahaan / Toko</th>
                                <th>Alamat Lengkap</th>
                                <th>No Telepon / WA</th>
                                <th>Email</th>
                                <th class="text-end pe-4">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (customers.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Tidak ada data customer ditemukan.</td>
                                </tr>
                            <% } else { %>
                                <% customers.forEach(customer => { %>
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark"><%= customer.name %></td>
                                        <td><%= customer.company || '-' %></td>
                                        <td class="small text-muted" style="max-width: 250px;"><%= customer.address || '-' %></td>
                                        <td><%= customer.phone || '-' %></td>
                                        <td class="small text-muted"><%= customer.email || '-' %></td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary me-1" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editCustomerModal"
                                                    data-id="<%= customer.id %>"
                                                    data-name="<%= customer.name %>"
                                                    data-company="<%= customer.company || '' %>"
                                                    data-address="<%= customer.address || '' %>"
                                                    data-phone="<%= customer.phone || '' %>"
                                                    data-email="<%= customer.email || '' %>">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </button>
                                            <form action="/customers/delete/<%= customer.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus customer <%= customer.name %>?')">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Hapus
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Add Customer -->
    <div class="modal fade" id="addCustomerModal" tabindex="-1">
        <div class="modal-dialog">
            <form action="/customers/create" method="POST" class="modal-content">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Tambah Customer Baru</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="name" class="form-label small fw-semibold">Nama Pelanggan (Bill To)</label>
                        <input type="text" class="form-control" id="name" name="name" required placeholder="Contoh: Gladya">
                    </div>
                    <div class="mb-3">
                        <label for="company" class="form-label small fw-semibold">Nama Perusahaan / Toko (Opsional)</label>
                        <input type="text" class="form-control" id="company" name="company" placeholder="Contoh: Toko Gladya Surabaya">
                    </div>
                    <div class="mb-3">
                        <label for="address" class="form-label small fw-semibold">Alamat Pengiriman</label>
                        <textarea class="form-control" id="address" name="address" rows="2" placeholder="Alamat lengkap..."></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="phone" class="form-label small fw-semibold">No Telepon / WA</label>
                            <input type="text" class="form-control" id="phone" name="phone" placeholder="0812...">
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label small fw-semibold">Email (Opsional)</label>
                            <input type="email" class="form-control" id="email" name="email" placeholder="customer@example.com">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary btn-primary-custom">Simpan Customer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Edit Customer -->
    <div class="modal fade" id="editCustomerModal" tabindex="-1">
        <div class="modal-dialog">
            <form action="/customers/update" method="POST" class="modal-content">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" id="edit_id" name="id">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit Data Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="edit_name" class="form-label small fw-semibold">Nama Pelanggan (Bill To)</label>
                        <input type="text" class="form-control" id="edit_name" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="edit_company" class="form-label small fw-semibold">Nama Perusahaan / Toko</label>
                        <input type="text" class="form-control" id="edit_company" name="company">
                    </div>
                    <div class="mb-3">
                        <label for="edit_address" class="form-label small fw-semibold">Alamat Pengiriman</label>
                        <textarea class="form-control" id="edit_address" name="address" rows="2"></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="edit_phone" class="form-label small fw-semibold">No Telepon / WA</label>
                            <input type="text" class="form-control" id="edit_phone" name="phone">
                        </div>
                        <div class="col-md-6">
                            <label for="edit_email" class="form-label small fw-semibold">Email</label>
                            <input type="email" class="form-control" id="edit_email" name="email">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary btn-primary-custom">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const editModal = document.getElementById('editCustomerModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    document.getElementById('edit_id').value = button.getAttribute('data-id');
                    document.getElementById('edit_name').value = button.getAttribute('data-name');
                    document.getElementById('edit_company').value = button.getAttribute('data-company') || '';
                    document.getElementById('edit_address').value = button.getAttribute('data-address') || '';
                    document.getElementById('edit_phone').value = button.getAttribute('data-phone') || '';
                    document.getElementById('edit_email').value = button.getAttribute('data-email') || '';
                });
            }
        });
    </script>

<%- include('../partials/footer') %>
