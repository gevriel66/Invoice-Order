<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/navbar') %>

    <div class="container-fluid p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">Riwayat Transaksi</h3>
                <p class="text-muted small mb-0">Daftar seluruh transaksi invoice & surat jalan. Dapat dicari, dibuka, difinalkan, dan diunduh PDF-nya.</p>
            </div>
            <a href="/transactions/create" class="btn btn-primary btn-primary-custom text-nowrap">
                <i class="bi bi-plus-circle me-1"></i> Buat Transaksi Baru
            </a>
        </div>

        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- Filter Card -->
        <div class="card card-custom mb-4">
            <div class="card-body p-3">
                <form action="/transactions" method="GET" class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" name="search" placeholder="Cari No Invoice, Customer, PO..." value="<%= filters.search %>">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Semua Status --</option>
                            <option value="DRAFT" <%= filters.status === 'DRAFT' ? 'selected' : '' %>>DRAFT (<%= counts.draft %>)</option>
                            <option value="FINAL" <%= filters.status === 'FINAL' ? 'selected' : '' %>>FINAL (<%= counts.final %>)</option>
                            <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED (<%= counts.cancelled %>)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                    </div>
                    <% if (filters.search || filters.status) { %>
                        <div class="col-md-2">
                            <a href="/transactions" class="btn btn-outline-secondary w-100">Reset</a>
                        </div>
                    <% } %>
                </form>
            </div>
        </div>

        <div class="card card-custom">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">No. Invoice</th>
                                <th>Tanggal</th>
                                <th>Pelanggan</th>
                                <th>Item</th>
                                <th>Total Pembayaran</th>
                                <th>Status</th>
                                <th>Dokumen PDF</th>
                                <th class="text-end pe-4">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (orders.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">Tidak ada data transaksi ditemukan.</td>
                                </tr>
                            <% } else { %>
                                <% orders.forEach(order => { %>
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">
                                            <%= order.invoice_number || 'DRAFT-' + String(order.id).padStart(4, '0') %>
                                        </td>
                                        <td class="small text-muted"><%= order.order_date %></td>
                                        <td>
                                            <div class="fw-semibold text-dark"><%= order.customer_name_snapshot %></div>
                                            <div class="small text-muted"><%= order.customer_company_snapshot || '-' %></div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border"><%= order.items.length %> item</span></td>
                                        <td class="fw-bold text-success">Rp <%= Number(order.total_amount).toLocaleString('id-ID') %></td>
                                        <td>
                                            <% if (order.status === 'FINAL') { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle me-1"></i> FINAL</span>
                                            <% } else if (order.status === 'DRAFT') { %>
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1"><i class="bi bi-pencil me-1"></i> DRAFT</span>
                                            <% } else { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle me-1"></i> CANCELLED</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <% if (order.invoice_pdf_path) { %>
                                                    <a href="/documents/invoice/<%= order.id %>" class="btn btn-sm btn-outline-success py-0 px-2 small" title="Download Invoice PDF">
                                                        <i class="bi bi-file-earmark-pdf"></i> Inv
                                                    </a>
                                                <% } %>
                                                <% if (order.surat_jalan_pdf_path) { %>
                                                    <a href="/documents/surat-jalan/<%= order.id %>" class="btn btn-sm btn-outline-info py-0 px-2 small" title="Download Surat Jalan PDF">
                                                        <i class="bi bi-truck"></i> SJ
                                                    </a>
                                                <% } %>
                                                <% if (!order.invoice_pdf_path && !order.surat_jalan_pdf_path) { %>
                                                    <span class="text-muted small">-</span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="/transactions/<%= order.id %>" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="bi bi-eye"></i> Detail
                                            </a>
                                            <% if (order.status === 'DRAFT') { %>
                                                <a href="/transactions/<%= order.id %>/edit" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-pencil-square"></i> Edit
                                                </a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

<%- include('../partials/footer') %>
