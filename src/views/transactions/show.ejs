<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/navbar') %>

    <div class="container-fluid p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="fw-bold text-dark mb-0">Detail Transaksi</h3>
                    <% if (order.status === 'FINAL') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-6 fw-normal"><i class="bi bi-check-circle me-1"></i> FINAL</span>
                    <% } else if (order.status === 'DRAFT') { %>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fs-6 fw-normal"><i class="bi bi-pencil me-1"></i> DRAFT</span>
                    <% } else { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fs-6 fw-normal"><i class="bi bi-x-circle me-1"></i> CANCELLED</span>
                    <% } %>
                </div>
                <p class="text-muted small mb-0">ID Transaksi: #<%= order.id %> | Nomor: <%= order.invoice_number || 'DRAFT-' + String(order.id).padStart(4, '0') %></p>
            </div>
            <a href="/transactions" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Kembali ke Riwayat
            </a>
        </div>

        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row g-4 mb-4">
            <!-- Header Left: Customer & Delivery Info -->
            <div class="col-md-6">
                <div class="card card-custom h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-person me-2 text-primary"></i> Informasi Pelanggan (Bill To)</h6>
                    </div>
                    <div class="card-body">
                        <h5 class="fw-bold text-dark mb-1"><%= order.customer_name_snapshot %></h5>
                        <% if (order.customer_company_snapshot) { %>
                            <div class="text-muted mb-2"><i class="bi bi-building me-1"></i> <%= order.customer_company_snapshot %></div>
                        <% } %>
                        <div class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i> <%= order.customer_address_snapshot || 'Alamat tidak diisi' %></div>
                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i> <%= order.customer_phone_snapshot || '-' %></div>
                    </div>
                </div>
            </div>

            <!-- Header Right: Document Details -->
            <div class="col-md-6">
                <div class="card card-custom h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-file-earmark-text me-2 text-info"></i> Detail Dokumen</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 small">
                            <div class="col-5 text-muted">No. Invoice Resmi:</div>
                            <div class="col-7 fw-bold text-dark"><%= order.invoice_number || '(Generated saat status FINAL)' %></div>

                            <div class="col-5 text-muted">Tanggal Invoice:</div>
                            <div class="col-7 text-dark"><%= order.order_date %></div>

                            <div class="col-5 text-muted">Tanggal Jatuh Tempo:</div>
                            <div class="col-7 text-dark"><%= order.due_date || '-' %></div>

                            <div class="col-5 text-muted">No. PO:</div>
                            <div class="col-7 text-dark"><%= order.po_number || '-' %></div>

                            <div class="col-5 text-muted">No. Referensi:</div>
                            <div class="col-7 text-dark"><%= order.ref_number || '-' %></div>

                            <div class="col-5 text-muted">Catatan:</div>
                            <div class="col-7 text-dark"><%= order.notes || '-' %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Document PDF Action Card for FINAL status -->
        <% if (order.status === 'FINAL') { %>
            <div class="card card-custom mb-4 border-primary">
                <div class="card-header bg-primary-subtle py-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-file-earmark-pdf me-2"></i> Cetak & Export Dokumen PDF (Template Excel)</h6>
                    <span class="badge bg-primary text-white">Excel COM Automation Engine</span>
                </div>
                <div class="card-body">
                    <div class="row align-items-center g-3">
                        <div class="col-md-6">
                            <div class="d-flex flex-wrap gap-2">
                                <form action="/transactions/<%= order.id %>/generate-pdf" method="POST" class="d-inline">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <input type="hidden" name="doc_type" value="invoice">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Generate Invoice
                                    </button>
                                </form>
                                <form action="/transactions/<%= order.id %>/generate-pdf" method="POST" class="d-inline">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <input type="hidden" name="doc_type" value="surat_jalan">
                                    <button type="submit" class="btn btn-outline-info btn-sm">
                                        <i class="bi bi-truck me-1"></i> Generate Surat Jalan
                                    </button>
                                </form>
                                <form action="/transactions/<%= order.id %>/generate-pdf" method="POST" class="d-inline">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <input type="hidden" name="doc_type" value="both">
                                    <button type="submit" class="btn btn-primary btn-sm fw-semibold">
                                        <i class="bi bi-collection me-1"></i> Generate Semua
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <div class="d-flex flex-wrap justify-content-md-end gap-2">
                                <% if (order.invoice_pdf_path) { %>
                                    <a href="/documents/invoice/<%= order.id %>" class="btn btn-success btn-sm fw-semibold" target="_blank">
                                        <i class="bi bi-download me-1"></i> Download Invoice PDF
                                    </a>
                                <% } %>
                                <% if (order.surat_jalan_pdf_path) { %>
                                    <a href="/documents/surat-jalan/<%= order.id %>" class="btn btn-info text-white btn-sm fw-semibold" target="_blank">
                                        <i class="bi bi-download me-1"></i> Download Surat Jalan PDF
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Items Table Card -->
        <div class="card card-custom mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-box me-2 text-success"></i> Rincian Barang Transaksi</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4" style="width: 50px;">#</th>
                                <th>Nama Barang</th>
                                <th>Merek</th>
                                <th class="text-center">Kuantitas</th>
                                <th class="text-center">Satuan</th>
                                <th class="text-end">Harga Satuan (Rp)</th>
                                <th class="text-end pe-4">Subtotal (Rp)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach((item, idx) => { %>
                                <tr>
                                    <td class="ps-4 text-muted"><%= idx + 1 %></td>
                                    <td class="fw-semibold text-dark"><%= item.product_name_snapshot %></td>
                                    <td><%= item.brand || '-' %></td>
                                    <td class="text-center fw-medium"><%= item.quantity %></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border"><%= item.unit_snapshot %></span></td>
                                    <td class="text-end">Rp <%= Number(item.price_snapshot).toLocaleString('id-ID') %></td>
                                    <td class="text-end pe-4 fw-bold text-secondary">Rp <%= Number(item.subtotal).toLocaleString('id-ID') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="6" class="text-end fw-bold fs-6">TOTAL PEMBAYARAN:</td>
                                <td class="text-end pe-4 fw-bold text-success fs-5">Rp <%= Number(order.total_amount).toLocaleString('id-ID') %></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Actions Footer Card -->
        <div class="card card-custom">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="text-muted small">
                    <% if (order.status === 'DRAFT') { %>
                        <i class="bi bi-info-circle text-warning me-1"></i> Transaksi masih berstatus DRAFT. Anda dapat mengedit item atau memfinalkannya.
                    <% } else if (order.status === 'FINAL') { %>
                        <i class="bi bi-lock-fill text-success me-1"></i> Transaksi berstatus FINAL dengan Nomor Invoice: <strong><%= order.invoice_number %></strong>. Data terkunci untuk menjaga konsistensi riwayat dokumen.
                    <% } %>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <% if (order.status === 'DRAFT') { %>
                        <a href="/transactions/<%= order.id %>/edit" class="btn btn-warning">
                            <i class="bi bi-pencil-square me-1"></i> Edit Transaksi
                        </a>
                        <form action="/transactions/<%= order.id %>/status" method="POST" class="d-inline" onsubmit="return confirm('Finalkan transaksi ini? Nomor Invoice resmi akan dibuat secara otomatis.')">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <input type="hidden" name="status" value="FINAL">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check2-circle me-1"></i> Finalkan Transaksi
                            </button>
                        </form>
                        <form action="/transactions/<%= order.id %>/status" method="POST" class="d-inline" onsubmit="return confirm('Batalkan transaksi ini?')">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <input type="hidden" name="status" value="CANCELLED">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i> Batalkan
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

<%- include('../partials/footer') %>
